# Copy this file outside the repository and replace every placeholder.
PA_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-at-least-32-random-characters
PA_DATABASE_APPLICATION_PASSWORD=replace-with-a-different-32-character-secret
PA_API_TOKEN=replace-with-the-existing-operator-token
PA_AUTHORIZED_SYNTHETIC_BUNDLE_HASHES=sha256:replace-with-an-exact-deployment-authorized-bundle-hash
PA_AUTHORIZED_DOCTRINE_PROPOSAL_HASHES=
PA_CHART_ARTIFACT_HOST_PATH=/home/replace-me/.local/share/pa-agent-lab/phase3a-artifacts

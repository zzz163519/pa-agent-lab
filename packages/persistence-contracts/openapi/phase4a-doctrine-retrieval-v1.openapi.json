  "components": {
    "schemas": {
      "DoctrineCorpusEntryV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-corpus-entry.v1"
          },
          "doctrineId": {
            "type": "string"
          },
          "proposalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "approvalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "sourceId": {
            "type": "string"
          },
          "sourceContentHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "ragRecord": {
            "$ref": "#/components/schemas/DoctrineRagRecordV1"
          },
          "ragRecordHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "schemaVersion",
          "doctrineId",
          "proposalHash",
          "approvalHash",
          "sourceId",
          "sourceContentHash",
          "ragRecord",
          "ragRecordHash"
        ],
        "additionalProperties": false
      },
      "ContractSha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "DoctrineRagRecordV1": {
        "type": "object",
        "properties": {
          "doctrineId": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "appliesWhen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoidWhen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisionEffect": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "doctrineId",
          "concept",
          "rule",
          "appliesWhen",
          "avoidWhen",
          "decisionEffect"
        ],
        "additionalProperties": false
      },
      "DoctrineCorpusSnapshotV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-corpus-snapshot.v1"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DoctrineCorpusEntryV1"
            }
          },
          "snapshotId": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "schemaVersion",
          "entries",
          "snapshotId"
        ],
        "additionalProperties": false
      },
      "DoctrineRetrievalProfileV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-retrieval-profile.v1"
          },
          "engine": {
            "type": "string",
            "const": "postgresql_fts"
          },
          "runtime": {
            "type": "string",
            "const": "pgvector/pgvector:0.8.6-pg18-trixie@sha256:8888de64a42b12a8e56df21d0d404c81864c18bafec7ab0f802a1453ec6cd352"
          },
          "postgresqlMajor": {
            "type": "number",
            "const": 18
          },
          "textSearchConfiguration": {
            "type": "string",
            "const": "pg_catalog.english"
          },
          "fields": {
            "type": "array",
            "minItems": 5,
            "items": [
              {
                "type": "string",
                "const": "concept"
              },
              {
                "type": "string",
                "const": "rule"
              },
              {
                "type": "string",
                "const": "appliesWhen"
              },
              {
                "type": "string",
                "const": "avoidWhen"
              },
              {
                "type": "string",
                "const": "decisionEffect"
              }
            ],
            "maxItems": 5
          },
          "fieldWeight": {
            "type": "string",
            "const": "D"
          },
          "arraySeparator": {
            "type": "string",
            "const": "\n"
          },
          "queryParser": {
            "type": "string",
            "const": "plainto_tsquery"
          },
          "matchPredicate": {
            "type": "string",
            "const": "document_vector_@@_parsed_query"
          },
          "rankFunction": {
            "type": "string",
            "const": "ts_rank_cd_0"
          },
          "defaultLimit": {
            "type": "number",
            "const": 5
          },
          "maxLimit": {
            "type": "number",
            "const": 8
          },
          "ordering": {
            "type": "string",
            "const": "rank_desc_doctrine_id_c"
          },
          "scoreEncoding": {
            "type": "string",
            "const": "float4send_hex"
          },
          "queryRewriting": {
            "type": "string",
            "const": "none"
          },
          "profileHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "schemaVersion",
          "engine",
          "runtime",
          "postgresqlMajor",
          "textSearchConfiguration",
          "fields",
          "fieldWeight",
          "arraySeparator",
          "queryParser",
          "matchPredicate",
          "rankFunction",
          "defaultLimit",
          "maxLimit",
          "ordering",
          "scoreEncoding",
          "queryRewriting",
          "profileHash"
        ],
        "additionalProperties": false
      },
      "DoctrineIngestionRunV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-ingestion-run.v1"
          },
          "snapshotId": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "profileHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "attemptIndex": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "entryCount": {
            "type": "number"
          },
          "ragRecordHashes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContractSha256"
            }
          },
          "logicalDocumentHashes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContractSha256"
            }
          },
          "lexicalManifestHash": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContractSha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "errorCodes": {
            "type": "array",

  "components": {
    "schemas": {
      "BrooksPromptPackageManifestV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "brooks-prompt-package-manifest.v1"
          },
          "packageVersion": {
            "type": "string",
            "const": "brooks-prompt-package.v1"
          },
          "prompt": {
            "type": "object",
            "properties": {
              "mediaType": {
                "type": "string",
                "const": "text/plain; charset=utf-8"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1
              },
              "contentHash": {
                "$ref": "#/components/schemas/ContractSha256"
              }
            },
            "required": [
              "mediaType",
              "byteLength",
              "contentHash"
            ],
            "additionalProperties": false
          },
          "responseSchema": {
            "type": "object",
            "properties": {
              "schemaId": {
                "type": "string"
              },
              "schemaVersion": {
                "type": "string",
                "const": "brooks-identity-free-response.schema.v1"
              },
              "mediaType": {
                "type": "string",
                "const": "application/schema+json"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1
              },
              "contentHash": {
                "$ref": "#/components/schemas/ContractSha256"
              }
            },
            "required": [
              "schemaId",
              "schemaVersion",
              "mediaType",
              "byteLength",
              "contentHash"
            ],
            "additionalProperties": false
          },
          "brooksDecisionContractVersion": {
            "type": "string",
            "const": "brooks-decision.v1"
          },
          "validatorVersion": {
            "type": "string",
            "const": "brooks-identity-free-response-validator.v1"
          },
          "packageHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "schemaVersion",
          "packageVersion",
          "prompt",
          "responseSchema",
          "brooksDecisionContractVersion",
          "validatorVersion",
          "packageHash"
        ],
        "additionalProperties": false
      },
      "ContractSha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "BrooksPromptPackageApprovalV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "brooks-prompt-package-approval.v1"

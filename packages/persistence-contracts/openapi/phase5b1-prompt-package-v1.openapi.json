          "approvalId": {
            "type": "string"
          },
          "packageVersion": {
            "type": "string",
            "const": "brooks-prompt-package.v1"
          },
          "packageHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "approvedBy": {
            "type": "string",
            "const": "Calvin"
          },
          "approvedAt": {
            "type": "string"
          },
          "approvalMethod": {
            "type": "string",
            "const": "direct-calvin-instruction"
          },
          "approvalScope": {
            "type": "string",
            "const": "exact-package-content-only"
          },
          "phase5b1ImplementationAuthorized": {
            "type": "boolean",
            "const": false
          },
          "packageActivationPerformed": {
            "type": "boolean",
            "const": false
          },
          "providerCallsAuthorized": {
            "type": "boolean",
            "const": false
          },
          "approvalRecordHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "schemaVersion",
          "approvalId",
          "packageVersion",
          "packageHash",
          "approvedBy",
          "approvedAt",
          "approvalMethod",
          "approvalScope",
          "phase5b1ImplementationAuthorized",
          "packageActivationPerformed",
          "providerCallsAuthorized",
          "approvalRecordHash"
        ],
        "additionalProperties": false
      },
      "BrooksPromptPackageActivationV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "brooks-prompt-package-activation.v1"
          },
          "activationKind": {
            "type": "string",
            "const": "standard"
          },
          "activationSequence": {
            "type": "integer",
            "minimum": 1
          },
          "packageHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "approvalRecordHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "operatorPrincipal": {
            "type": "string",
            "const": "local:phase2-operator"
          },
          "activationId": {
            "$ref": "#/components/schemas/ContractSha256"

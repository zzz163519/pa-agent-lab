                    "barId": {
                      "type": "string"
                    },
                    "sequence": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "open": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    },
                    "low": {
                      "type": "number"
                    },
                    "close": {
                      "type": "number"
                    },

            "type": "string",
            "const": "rollback"
          },
          "activationSequence": {
            "type": "integer",
            "minimum": 1
          },
          "replacesActivationId": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "targetActivationId": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "packageHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "approvalRecordHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
          },
          "reasonHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "operatorPrincipal": {
            "type": "string",
            "const": "local:phase2-operator"
          },
          "activationId": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "schemaVersion",
          "activationKind",
          "activationSequence",
          "replacesActivationId",
          "targetActivationId",
          "packageHash",
          "approvalRecordHash",
          "reason",
          "reasonHash",
          "operatorPrincipal",
          "activationId"
        ],
        "additionalProperties": false
      },

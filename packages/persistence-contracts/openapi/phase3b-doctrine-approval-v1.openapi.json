  "components": {
    "schemas": {
      "DoctrineProposalBundleV1": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceV1"
          },
          "doctrineUnit": {
            "$ref": "#/components/schemas/DoctrineUnitV1"
          },
          "sourceLocator": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*",
            "maxLength": 600
          },
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-proposal-bundle.v1"
          },
          "proposalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "doctrineUnit",
          "proposalHash",
          "schemaVersion",
          "source",
          "sourceLocator"
        ],
        "additionalProperties": false
      },
      "SourceV1": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceTypeV1",
            "enum": [
              "brooks_website",
              "official_youtube",
              "reviewed_transcript"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "urlOrLocalRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$"
          },
          "contentHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "private": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "sourceId",
          "sourceType",
          "title",
          "urlOrLocalRef",
          "contentHash",
          "private"
        ],
        "additionalProperties": false
      },
      "SourceTypeV1": {
        "type": "string",
        "enum": [
          "brooks_website",
          "official_youtube",
          "reviewed_transcript",
          "private_material"
        ]
      },
      "ContractSha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "DoctrineUnitV1": {
        "type": "object",
        "properties": {
          "doctrineId": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "appliesWhen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "minItems": 1,
            "maxItems": 12
          },
          "avoidWhen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "minItems": 1,
            "maxItems": 12
          },
          "decisionEffect": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "minItems": 1,
            "maxItems": 12
          },
          "status": {
            "$ref": "#/components/schemas/DoctrineStatusV1",
            "const": "draft"
          }
        },
        "required": [
          "doctrineId",
          "sourceId",
          "concept",
          "rule",
          "appliesWhen",
          "avoidWhen",
          "decisionEffect",
          "status"
        ],
        "additionalProperties": false
      },
      "DoctrineStatusV1": {
        "type": "string",
        "enum": [
          "draft",
          "approved",
          "retired"
        ]
      },
      "DoctrineApprovalV1": {
        "type": "object",
        "properties": {
          "proposalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "doctrineId": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "sourceContentHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "approverPrincipal": {
            "$ref": "#/components/schemas/DoctrineApproverPrincipalV1"
          },
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-approval.v1"
          },
          "approvalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "approvalHash",
          "approverPrincipal",
          "doctrineId",
          "proposalHash",
          "schemaVersion",
          "sourceContentHash",
          "sourceId"
        ],
        "additionalProperties": false
      },
      "DoctrineApproverPrincipalV1": {
        "type": "string",
        "enum": [
          "local:phase2-operator",
          "local:calvin-reviewer"
        ]
      },
      "DoctrineRetirementV1": {
        "type": "object",
        "properties": {
          "proposalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "approvalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "doctrineId": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "retiredByPrincipal": {
            "$ref": "#/components/schemas/DoctrineApproverPrincipalV1"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*",
            "maxLength": 400
          },
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-retirement.v1"
          },
          "retirementHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "approvalHash",
          "doctrineId",
          "proposalHash",
          "reason",
          "retiredByPrincipal",
          "retirementHash",
          "schemaVersion"
        ],
        "additionalProperties": false
      },
      "DoctrineWorkQueueV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-work-queue.v1"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "proposalHash": {
                  "$ref": "#/components/schemas/ContractSha256"
                },
                "doctrineId": {
                  "type": "string"
                },
                "sourceId": {
                  "type": "string"
                },
                "concept": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/components/schemas/DoctrineStatusV1"
                },
                "approverPrincipal": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DoctrineApproverPrincipalV1"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "proposalHash",
                "doctrineId",
                "sourceId",
                "concept",
                "status",
                "approverPrincipal"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemaVersion",
          "items"
        ],
        "additionalProperties": false
      },
      "DoctrineWorkItemV1": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "doctrine-work-item.v1"
          },
          "proposal": {
            "$ref": "#/components/schemas/DoctrineProposalBundleV1"
          },
          "status": {
            "$ref": "#/components/schemas/DoctrineStatusV1"
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DoctrineApprovalV1"
              },
              {
                "type": "null"
              }
            ]
          },
          "retirement": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DoctrineRetirementV1"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schemaVersion",
          "proposal",
          "status",
          "approval",
          "retirement"
        ],
        "additionalProperties": false
      },
      "ApproveDoctrineCommandV1": {
        "type": "object",
        "properties": {
          "proposalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          }
        },
        "required": [
          "proposalHash"
        ],
        "additionalProperties": false
      },
      "RetireDoctrineCommandV1": {
        "type": "object",
        "properties": {
          "approvalHash": {
            "$ref": "#/components/schemas/ContractSha256"
          },
          "reason": {
            "type": "string",

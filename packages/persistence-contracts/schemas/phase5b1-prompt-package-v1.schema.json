{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pa-agent-lab.local/schemas/phase5b1-prompt-package-v1",
  "$defs": {
    "BrooksPromptPackageManifestV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-prompt-package-manifest.v1"
        },
        "packageVersion": {
          "type": "string",
          "const": "brooks-prompt-package.v1"
        },
        "prompt": {
          "type": "object",
          "properties": {
            "mediaType": {
              "type": "string",
              "const": "text/plain; charset=utf-8"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            },
            "contentHash": {
              "$ref": "#/$defs/ContractSha256"
            }
          },
          "required": [
            "mediaType",
            "byteLength",
            "contentHash"
          ],
          "additionalProperties": false
        },
        "responseSchema": {
          "type": "object",
          "properties": {
            "schemaId": {
              "type": "string"
            },
            "schemaVersion": {
              "type": "string",
              "const": "brooks-identity-free-response.schema.v1"
            },
            "mediaType": {
              "type": "string",
              "const": "application/schema+json"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            },
            "contentHash": {
              "$ref": "#/$defs/ContractSha256"
            }
          },
          "required": [
            "schemaId",
            "schemaVersion",
            "mediaType",
            "byteLength",
            "contentHash"
          ],
          "additionalProperties": false
        },
        "brooksDecisionContractVersion": {
          "type": "string",
          "const": "brooks-decision.v1"
        },
        "validatorVersion": {
          "type": "string",
          "const": "brooks-identity-free-response-validator.v1"
        },
        "packageHash": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "schemaVersion",
        "packageVersion",
        "prompt",
        "responseSchema",
        "brooksDecisionContractVersion",
        "validatorVersion",
        "packageHash"
      ],
      "additionalProperties": false
    },
    "ContractSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "BrooksPromptPackageApprovalV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-prompt-package-approval.v1"
        },
        "approvalId": {
          "type": "string"
        },
        "packageVersion": {
          "type": "string",
          "const": "brooks-prompt-package.v1"
        },
        "packageHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "approvedBy": {
          "type": "string",
          "const": "Calvin"
        },
        "approvedAt": {
          "type": "string"
        },
        "approvalMethod": {
          "type": "string",
          "const": "direct-calvin-instruction"
        },
        "approvalScope": {
          "type": "string",
          "const": "exact-package-content-only"
        },
        "phase5b1ImplementationAuthorized": {
          "type": "boolean",
          "const": false
        },
        "packageActivationPerformed": {
          "type": "boolean",
          "const": false
        },
        "providerCallsAuthorized": {
          "type": "boolean",
          "const": false
        },
        "approvalRecordHash": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "schemaVersion",
        "approvalId",
        "packageVersion",
        "packageHash",
        "approvedBy",
        "approvedAt",
        "approvalMethod",
        "approvalScope",
        "phase5b1ImplementationAuthorized",
        "packageActivationPerformed",
        "providerCallsAuthorized",
        "approvalRecordHash"
      ],
      "additionalProperties": false
    },
    "BrooksPromptPackageActivationV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-prompt-package-activation.v1"
        },
        "activationKind": {
          "type": "string",
          "const": "standard"
        },
        "activationSequence": {
          "type": "integer",
          "minimum": 1
        },
        "packageHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "approvalRecordHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "operatorPrincipal": {
          "type": "string",
          "const": "local:phase2-operator"
        },
        "activationId": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "schemaVersion",
        "activationKind",
        "activationSequence",
        "packageHash",
        "approvalRecordHash",
        "operatorPrincipal",
        "activationId"
      ],
      "additionalProperties": false
    },
    "BrooksPromptPackageRollbackActivationV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-prompt-package-rollback-activation.v1"
        },
        "activationKind": {
          "type": "string",
          "const": "rollback"
        },
        "activationSequence": {
          "type": "integer",
          "minimum": 1
        },
        "replacesActivationId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "targetActivationId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "packageHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "approvalRecordHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
        },
        "reasonHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "operatorPrincipal": {
          "type": "string",
          "const": "local:phase2-operator"
        },
        "activationId": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "schemaVersion",
        "activationKind",
        "activationSequence",
        "replacesActivationId",
        "targetActivationId",
        "packageHash",
        "approvalRecordHash",
        "reason",
        "reasonHash",
        "operatorPrincipal",
        "activationId"
      ],
      "additionalProperties": false
    },
    "BrooksPromptPackageActivationAuthorityV1": {
      "anyOf": [
        {
          "$ref": "#/$defs/BrooksPromptPackageActivationV1"
        },
        {
          "$ref": "#/$defs/BrooksPromptPackageRollbackActivationV1"
        }
      ]
    },
    "PreparedPolicyPayloadV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "prepared-policy-payload.v1"
        },
        "preparationRulesVersion": {
          "type": "string",
          "const": "prepared-policy-payload-rules.v1"
        },
        "sourceScope": {
          "type": "string",
          "const": "synthetic_fixture_only"
        },
        "preparationId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "assemblyId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "packageActivationId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "packageHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "promptHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "responseSchemaHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "outputSchemaVersion": {
          "type": "string"
        },
        "validatorVersion": {
          "type": "string",
          "const": "brooks-identity-free-response-validator.v1"
        },
        "payload": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "outbound-model-payload.v1"
            },
            "payloadHash": {
              "$ref": "#/$defs/ContractSha256"
            },
            "policyInput": {
              "$ref": "#/$defs/BrooksPolicyInputV1"
            },
            "promptHash": {
              "$ref": "#/$defs/ContractSha256"
            },
            "outputSchemaVersion": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "payloadHash",
            "policyInput",
            "promptHash",
            "outputSchemaVersion"
          ],
          "additionalProperties": false
        },
        "payloadHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "operatorPrincipal": {
          "type": "string",
          "const": "local:phase2-operator"
        }
      },
      "required": [
        "schemaVersion",
        "preparationRulesVersion",
        "sourceScope",
        "preparationId",
        "assemblyId",
        "packageActivationId",
        "packageHash",
        "promptHash",
        "responseSchemaHash",
        "outputSchemaVersion",
        "validatorVersion",
        "payload",
        "payloadHash",
        "operatorPrincipal"
      ],
      "additionalProperties": false
    },
    "BrooksPolicyInputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-policy-input.v1"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "market": {
          "type": "object",
          "properties": {
            "barDurationSeconds": {
              "type": "integer",
              "const": 300,
              "minimum": 0
            },
            "lastVisibleBarId": {
              "type": "string"
            },
            "visibleBarCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            "isLeftCensored": {
              "type": "boolean"
            },
            "leftCensoredBarsMissing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "normalization": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "first_visible_close_equals_100"
                },
                "base": {
                  "type": "number",
                  "const": 100
                },
                "anchorBarId": {
                  "type": "string"
                }
              },
              "required": [
                "method",
                "base",
                "anchorBarId"
              ],
              "additionalProperties": false
            },
            "bars": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "barId": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "close": {
                    "type": "number"
                  },
                  "continuityFromPrevious": {
                    "$ref": "#/$defs/BarContinuityStateV1"
                  }
                },
                "required": [
                  "barId",
                  "sequence",
                  "open",
                  "high",
                  "low",
                  "close",
                  "continuityFromPrevious"
                ],
                "additionalProperties": false
              },
              "minItems": 40,
              "maxItems": 120
            }
          },
          "required": [
            "barDurationSeconds",
            "lastVisibleBarId",
            "visibleBarCount",
            "isLeftCensored",
            "leftCensoredBarsMissing",
            "normalization",
            "bars"
          ],
          "additionalProperties": false
        },
        "charts": {
          "type": "object",
          "properties": {
            "context": {
              "type": "object",
              "properties": {
                "panel": {
                  "type": "string",
                  "enum": [
                    "context",
                    "detail"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentHash": {
                  "$ref": "#/$defs/ContractSha256"
                },
                "barIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 40,
                  "maxItems": 120
                },
                "lastVisibleBarId": {
                  "type": "string"
                }
              },
              "required": [
                "panel",
                "mediaType",
                "contentHash",
                "barIds",
                "lastVisibleBarId"
              ],
              "additionalProperties": false
            },
            "detail": {
              "type": "object",
              "properties": {
                "panel": {
                  "type": "string",
                  "enum": [
                    "context",
                    "detail"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentHash": {
                  "$ref": "#/$defs/ContractSha256"
                },
                "barIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 40,
                  "maxItems": 120
                },
                "lastVisibleBarId": {
                  "type": "string"
                }
              },
              "required": [
                "panel",
                "mediaType",
                "contentHash",
                "barIds",
                "lastVisibleBarId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "context",
            "detail"
          ],
          "additionalProperties": false
        },
        "doctrine": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doctrineId": {
                "type": "string"
              },
              "concept": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "appliesWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "avoidWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decisionEffect": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "doctrineId",
              "concept",
              "rule",
              "appliesWhen",
              "avoidWhen",
              "decisionEffect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "inputHash",
        "market",
        "charts",
        "doctrine"
      ],
      "additionalProperties": false
    },
    "BarContinuityStateV1": {
      "type": "string",
      "enum": [
        "contiguous",
        "session_boundary",
        "missing_data",
        "unknown"
      ]
    },
    "ActivateBrooksPromptPackageCommandV1": {
      "type": "object",
      "additionalProperties": {
        "not": {}
      }
    },
    "RollbackBrooksPromptPackageCommandV1": {
      "type": "object",
      "properties": {
        "targetActivationId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "required": [
        "targetActivationId",
        "reason"
      ],
      "additionalProperties": false
    },
    "PreparePolicyPayloadCommandV1": {
      "type": "object",
      "properties": {
        "assemblyId": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "assemblyId"
      ],
      "additionalProperties": false
    },
    "CaseApiErrorV1": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/CaseApiErrorCodeV1"
        },
        "message": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string",
          "const": "case-api-error.v1"
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "CaseApiErrorCodeV1": {
      "type": "string",
      "enum": [
        "INVALID_JSON",
        "INVALID_RECORD",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "NOT_FOUND",
        "IDENTITY_CONFLICT",
        "BODY_TOO_LARGE",
        "DEPENDENCY_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    }
  }
}

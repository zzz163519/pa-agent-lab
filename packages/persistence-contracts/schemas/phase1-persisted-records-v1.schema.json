{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pa-agent-lab.local/schemas/phase1-persisted-records-v1",
  "$defs": {
    "BrooksPolicyCaseV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-policy-case.v1"
        },
        "caseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "caseId": {
          "type": "string"
        },
        "policyStreamId": {
          "type": "string"
        },
        "barDurationSeconds": {
          "type": "integer",
          "const": 300,
          "minimum": 0
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "barId": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "open": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              },
              "isClosed": {
                "type": "boolean"
              },
              "continuityFromPrevious": {
                "$ref": "#/$defs/BarContinuityStateV1"
              }
            },
            "required": [
              "barId",
              "sequence",
              "open",
              "high",
              "low",
              "close",
              "isClosed",
              "continuityFromPrevious"
            ],
            "additionalProperties": false
          },
          "minItems": 40,
          "maxItems": 120
        },
        "lastVisibleBarId": {
          "type": "string"
        },
        "isLeftCensored": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "caseHash",
        "caseId",
        "policyStreamId",
        "barDurationSeconds",
        "bars",
        "lastVisibleBarId",
        "isLeftCensored"
      ],
      "additionalProperties": false
    },
    "ContractSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "BarContinuityStateV1": {
      "type": "string",
      "enum": [
        "contiguous",
        "session_boundary",
        "missing_data",
        "unknown"
      ]
    },
    "BrooksPolicyInputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-policy-input.v1"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "market": {
          "type": "object",
          "properties": {
            "barDurationSeconds": {
              "type": "integer",
              "const": 300,
              "minimum": 0
            },
            "lastVisibleBarId": {
              "type": "string"
            },
            "visibleBarCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            "isLeftCensored": {
              "type": "boolean"
            },
            "leftCensoredBarsMissing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "normalization": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "first_visible_close_equals_100"
                },
                "base": {
                  "type": "number",
                  "const": 100
                },
                "anchorBarId": {
                  "type": "string"
                }
              },
              "required": [
                "method",
                "base",
                "anchorBarId"
              ],
              "additionalProperties": false
            },
            "bars": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "barId": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "close": {
                    "type": "number"
                  },
                  "continuityFromPrevious": {
                    "$ref": "#/$defs/BarContinuityStateV1"
                  }
                },
                "required": [
                  "barId",
                  "sequence",
                  "open",
                  "high",
                  "low",
                  "close",
                  "continuityFromPrevious"
                ],
                "additionalProperties": false
              },
              "minItems": 40,
              "maxItems": 120
            }
          },
          "required": [
            "barDurationSeconds",
            "lastVisibleBarId",
            "visibleBarCount",
            "isLeftCensored",
            "leftCensoredBarsMissing",
            "normalization",
            "bars"
          ],
          "additionalProperties": false
        },
        "charts": {
          "type": "object",
          "properties": {
            "context": {
              "type": "object",
              "properties": {
                "panel": {
                  "type": "string",
                  "enum": [
                    "context",
                    "detail"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentHash": {
                  "$ref": "#/$defs/ContractSha256"
                },
                "barIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 40,
                  "maxItems": 120
                },
                "lastVisibleBarId": {
                  "type": "string"
                }
              },
              "required": [
                "panel",
                "mediaType",
                "contentHash",
                "barIds",
                "lastVisibleBarId"
              ],
              "additionalProperties": false
            },
            "detail": {
              "type": "object",
              "properties": {
                "panel": {
                  "type": "string",
                  "enum": [
                    "context",
                    "detail"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentHash": {
                  "$ref": "#/$defs/ContractSha256"
                },
                "barIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 40,
                  "maxItems": 120
                },
                "lastVisibleBarId": {
                  "type": "string"
                }
              },
              "required": [
                "panel",
                "mediaType",
                "contentHash",
                "barIds",
                "lastVisibleBarId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "context",
            "detail"
          ],
          "additionalProperties": false
        },
        "doctrine": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doctrineId": {
                "type": "string"
              },
              "concept": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "appliesWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "avoidWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decisionEffect": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "doctrineId",
              "concept",
              "rule",
              "appliesWhen",
              "avoidWhen",
              "decisionEffect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "inputHash",
        "market",
        "charts",
        "doctrine"
      ],
      "additionalProperties": false
    },
    "AnonymousChartArtifactMetadataV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "anonymous-chart-artifact-metadata.v1"
        },
        "metadataId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "artifactId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "sourceCaseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "anonymousMarketHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "rendererId": {
          "type": "string",
          "const": "pa-candlestick-svg-resvg.v1"
        },
        "rendererRuntime": {
          "type": "string",
          "const": "@resvg/resvg-js@2.6.2"
        },
        "rendererPlatform": {
          "type": "string",
          "const": "@resvg/resvg-js-linux-x64-gnu@2.6.2"
        },
        "panel": {
          "type": "string",
          "enum": [
            "context",
            "detail"
          ]
        },
        "mediaType": {
          "type": "string",
          "const": "image/png"
        },
        "widthPx": {
          "type": "integer",
          "const": 1200,
          "minimum": 1
        },
        "heightPx": {
          "type": "integer",
          "const": 720,
          "minimum": 1
        },
        "renderInputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "contentHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "barIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 40,
          "maxItems": 120
        },
        "lastVisibleBarId": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "metadataId",
        "artifactId",
        "sourceCaseHash",
        "anonymousMarketHash",
        "rendererId",
        "rendererRuntime",
        "rendererPlatform",
        "panel",
        "mediaType",
        "widthPx",
        "heightPx",
        "renderInputHash",
        "contentHash",
        "byteLength",
        "barIds",
        "lastVisibleBarId"
      ],
      "additionalProperties": false
    },
    "ModelRunRecordV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "model-run.v1"
        },
        "modelRunId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "callId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "caseId": {
          "type": "string"
        },
        "caseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "localLastVisibleBarId": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ModelCallMode"
        },
        "policyStreamId": {
          "type": "string"
        },
        "decisionPointBarId": {
          "type": "string"
        },
        "decisionPointSequence": {
          "type": "integer",
          "minimum": 0
        },
        "candidateId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "payloadHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "promptHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "outputSchemaVersion": {
          "type": "string"
        },
        "reasoningBudgetId": {
          "type": "string"
        },
        "repeatIndex": {
          "type": "integer",
          "minimum": 0
        },
        "retrievedDoctrineIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "modelRunId",
        "callId",
        "caseId",
        "caseHash",
        "localLastVisibleBarId",
        "mode",
        "policyStreamId",
        "decisionPointBarId",
        "decisionPointSequence",
        "candidateId",
        "modelId",
        "inputHash",
        "payloadHash",
        "promptHash",
        "outputSchemaVersion",
        "reasoningBudgetId",
        "repeatIndex",
        "retrievedDoctrineIds"
      ],
      "additionalProperties": false
    },
    "ModelCallMode": {
      "type": "string",
      "enum": [
        "evaluation_sampled",
        "continuous_every_close"
      ]
    },
    "ProviderAttemptRecordV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "provider-attempt.v1"
        },
        "attemptId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "attemptKey": {
          "$ref": "#/$defs/ContractSha256"
        },
        "modelRunId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "callId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "attemptIndex": {
          "type": "integer",
          "minimum": 0
        },
        "providerId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "requestHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "status": {
          "$ref": "#/$defs/ProviderAttemptStatusV1"
        },
        "responseHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractSha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "latencyMs": {
          "type": "number"
        }
      },
      "required": [
        "schemaVersion",
        "attemptId",
        "attemptKey",
        "modelRunId",
        "callId",
        "attemptIndex",
        "providerId",
        "modelId",
        "requestHash",
        "status",
        "responseHash",
        "errorCode",
        "latencyMs"
      ],
      "additionalProperties": false
    },
    "ProviderAttemptStatusV1": {
      "type": "string",
      "enum": [
        "response_received",
        "timeout",
        "transport_error"
      ]
    },
    "ModelRunAuditRecordV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "model-run-audit.v1"
        },
        "auditId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "modelRunId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "callId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "attemptId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "caseId": {
          "type": "string"
        },
        "caseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "payloadHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "promptHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "retrievedDoctrineIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rawOutputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "decisionHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractSha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "validationResultHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "validationStatus": {
          "$ref": "#/$defs/ModelRunValidationStatusV1"
        },
        "rejectionCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "auditId",
        "modelRunId",
        "callId",
        "attemptId",
        "caseId",
        "caseHash",
        "inputHash",
        "payloadHash",
        "promptHash",
        "retrievedDoctrineIds",
        "rawOutputHash",
        "decisionHash",
        "validationResultHash",
        "validationStatus",
        "rejectionCodes"
      ],
      "additionalProperties": false
    },
    "ModelRunValidationStatusV1": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    }
  }
}

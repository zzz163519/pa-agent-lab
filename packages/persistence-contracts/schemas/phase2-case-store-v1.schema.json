{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pa-agent-lab.local/schemas/phase2-case-store-v1",
  "$defs": {
    "SyntheticCaseBundleV1": {
      "type": "object",
      "properties": {
        "sourceScope": {
          "type": "string",
          "const": "synthetic_fixture_only"
        },
        "policyCase": {
          "$ref": "#/$defs/BrooksPolicyCaseV1"
        },
        "policyInput": {
          "$ref": "#/$defs/BrooksPolicyInputV1"
        },
        "chartMetadata": {
          "type": "object",
          "properties": {
            "context": {
              "$ref": "#/$defs/AnonymousChartArtifactMetadataV1"
            },
            "detail": {
              "$ref": "#/$defs/AnonymousChartArtifactMetadataV1"
            }
          },
          "required": [
            "context",
            "detail"
          ],
          "additionalProperties": false
        },
        "binding": {
          "$ref": "#/$defs/SyntheticCaseBindingV1"
        },
        "schemaVersion": {
          "type": "string",
          "const": "synthetic-case-bundle.v1"
        },
        "bundleHash": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "binding",
        "bundleHash",
        "chartMetadata",
        "policyCase",
        "policyInput",
        "schemaVersion",
        "sourceScope"
      ],
      "additionalProperties": false
    },
    "BrooksPolicyCaseV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-policy-case.v1"
        },
        "caseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "caseId": {
          "type": "string"
        },
        "policyStreamId": {
          "type": "string"
        },
        "barDurationSeconds": {
          "type": "integer",
          "const": 300,
          "minimum": 0
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "barId": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "open": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              },
              "isClosed": {
                "type": "boolean"
              },
              "continuityFromPrevious": {
                "$ref": "#/$defs/BarContinuityStateV1"
              }
            },
            "required": [
              "barId",
              "sequence",
              "open",
              "high",
              "low",
              "close",
              "isClosed",
              "continuityFromPrevious"
            ],
            "additionalProperties": false
          },
          "minItems": 40,
          "maxItems": 120
        },
        "lastVisibleBarId": {
          "type": "string"
        },
        "isLeftCensored": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "caseHash",
        "caseId",
        "policyStreamId",
        "barDurationSeconds",
        "bars",
        "lastVisibleBarId",
        "isLeftCensored"
      ],
      "additionalProperties": false
    },
    "ContractSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "BarContinuityStateV1": {
      "type": "string",
      "enum": [
        "contiguous",
        "session_boundary",
        "missing_data",
        "unknown"
      ]
    },
    "BrooksPolicyInputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "brooks-policy-input.v1"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "market": {
          "type": "object",
          "properties": {
            "barDurationSeconds": {
              "type": "integer",
              "const": 300,
              "minimum": 0
            },
            "lastVisibleBarId": {
              "type": "string"
            },
            "visibleBarCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            "isLeftCensored": {
              "type": "boolean"
            },
            "leftCensoredBarsMissing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "normalization": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "first_visible_close_equals_100"
                },
                "base": {
                  "type": "number",
                  "const": 100
                },
                "anchorBarId": {
                  "type": "string"
                }
              },
              "required": [
                "method",
                "base",
                "anchorBarId"
              ],
              "additionalProperties": false
            },
            "bars": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "barId": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "close": {
                    "type": "number"
                  },
                  "continuityFromPrevious": {
                    "$ref": "#/$defs/BarContinuityStateV1"
                  }
                },
                "required": [
                  "barId",
                  "sequence",
                  "open",
                  "high",
                  "low",
                  "close",
                  "continuityFromPrevious"
                ],
                "additionalProperties": false
              },
              "minItems": 40,
              "maxItems": 120
            }
          },
          "required": [
            "barDurationSeconds",
            "lastVisibleBarId",
            "visibleBarCount",
            "isLeftCensored",
            "leftCensoredBarsMissing",
            "normalization",
            "bars"
          ],
          "additionalProperties": false
        },
        "charts": {
          "type": "object",
          "properties": {
            "context": {
              "type": "object",
              "properties": {
                "panel": {
                  "type": "string",
                  "enum": [
                    "context",
                    "detail"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentHash": {
                  "$ref": "#/$defs/ContractSha256"
                },
                "barIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 40,
                  "maxItems": 120
                },
                "lastVisibleBarId": {
                  "type": "string"
                }
              },
              "required": [
                "panel",
                "mediaType",
                "contentHash",
                "barIds",
                "lastVisibleBarId"
              ],
              "additionalProperties": false
            },
            "detail": {
              "type": "object",
              "properties": {
                "panel": {
                  "type": "string",
                  "enum": [
                    "context",
                    "detail"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentHash": {
                  "$ref": "#/$defs/ContractSha256"
                },
                "barIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 40,
                  "maxItems": 120
                },
                "lastVisibleBarId": {
                  "type": "string"
                }
              },
              "required": [
                "panel",
                "mediaType",
                "contentHash",
                "barIds",
                "lastVisibleBarId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "context",
            "detail"
          ],
          "additionalProperties": false
        },
        "doctrine": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doctrineId": {
                "type": "string"
              },
              "concept": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "appliesWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "avoidWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decisionEffect": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "doctrineId",
              "concept",
              "rule",
              "appliesWhen",
              "avoidWhen",
              "decisionEffect"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "inputHash",
        "market",
        "charts",
        "doctrine"
      ],
      "additionalProperties": false
    },
    "AnonymousChartArtifactMetadataV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "anonymous-chart-artifact-metadata.v1"
        },
        "metadataId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "artifactId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "sourceCaseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "anonymousMarketHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "rendererId": {
          "type": "string",
          "const": "pa-candlestick-svg-resvg.v1"
        },
        "rendererRuntime": {
          "type": "string",
          "const": "@resvg/resvg-js@2.6.2"
        },
        "rendererPlatform": {
          "type": "string",
          "const": "@resvg/resvg-js-linux-x64-gnu@2.6.2"
        },
        "panel": {
          "type": "string",
          "enum": [
            "context",
            "detail"
          ]
        },
        "mediaType": {
          "type": "string",
          "const": "image/png"
        },
        "widthPx": {
          "type": "integer",
          "const": 1200,
          "minimum": 1
        },
        "heightPx": {
          "type": "integer",
          "const": 720,
          "minimum": 1
        },
        "renderInputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "contentHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "barIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 40,
          "maxItems": 120
        },
        "lastVisibleBarId": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "metadataId",
        "artifactId",
        "sourceCaseHash",
        "anonymousMarketHash",
        "rendererId",
        "rendererRuntime",
        "rendererPlatform",
        "panel",
        "mediaType",
        "widthPx",
        "heightPx",
        "renderInputHash",
        "contentHash",
        "byteLength",
        "barIds",
        "lastVisibleBarId"
      ],
      "additionalProperties": false
    },
    "SyntheticCaseBindingV1": {
      "type": "object",
      "properties": {
        "caseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "contextMetadataId": {
          "$ref": "#/$defs/ContractSha256"
        },
        "detailMetadataId": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "caseHash",
        "inputHash",
        "contextMetadataId",
        "detailMetadataId"
      ],
      "additionalProperties": false
    },
    "CaseAuditViewV1": {
      "type": "object",
      "properties": {
        "caseBundle": {
          "$ref": "#/$defs/SyntheticCaseBundleV1"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrooksDecisionV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalvinReviewV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaVersion": {
          "type": "string",
          "const": "case-audit-view.v1"
        },
        "auditHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "caseHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "decisionConflict": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionConflictV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "auditHash",
        "caseBundle",
        "caseHash",
        "decision",
        "decisionConflict",
        "review",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "BrooksDecisionV1": {
      "type": "object",
      "properties": {
        "decisionId": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "inputHash": {
          "$ref": "#/$defs/ContractSha256"
        },
        "lastVisibleBarId": {
          "type": "string"
        },
        "barDurationSeconds": {
          "type": "integer",
          "minimum": 0,
          "const": 300
        },
        "verdict": {
          "$ref": "#/$defs/BrooksVerdictV1"
        },
        "evidenceBalance": {
          "$ref": "#/$defs/EvidenceBalanceV1"
        },
        "broadContext": {
          "$ref": "#/$defs/BroadContextV1"
        },
        "currentLeg": {
          "$ref": "#/$defs/CurrentLegV1"
        },
        "alwaysIn": {
          "$ref": "#/$defs/AlwaysInV1"
        },
        "pressure": {
          "$ref": "#/$defs/PressureAssessmentV1"
        },
        "breakoutLifecycle": {
          "$ref": "#/$defs/BreakoutLifecycleV1"
        },
        "reversalLifecycle": {
          "$ref": "#/$defs/ReversalLifecycleV1"
        },
        "structures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarketStructureV1"
          }
        },
        "magnets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MagnetV1"
          }
        },
        "marketEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarketEvidenceV1"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DecisionClaimV1"
          }
        },
        "longCase": {
          "$ref": "#/$defs/DirectionalCaseV1"
        },
        "shortCase": {
          "$ref": "#/$defs/DirectionalCaseV1"
        },
        "tradePlan": {
          "anyOf": [
            {
              "$ref": "#/$defs/TradePlanV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "noTrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoTradeDecisionV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/UncertainDecisionV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "humanSummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "schemaVersion": {
          "type": "string",
          "const": "brooks-decision.v1"
        },
        "decisionHash": {
          "$ref": "#/$defs/ContractSha256"
        }
      },
      "required": [
        "alwaysIn",
        "barDurationSeconds",
        "breakoutLifecycle",
        "broadContext",
        "caseId",
        "claims",
        "currentLeg",
        "decisionHash",
        "decisionId",
        "evidenceBalance",
        "humanSummary",
        "inputHash",
        "lastVisibleBarId",
        "longCase",
        "magnets",
        "marketEvidence",
        "noTrade",
        "pressure",
        "reversalLifecycle",
        "schemaVersion",
        "shortCase",
        "structures",
        "tradePlan",
        "uncertainty",
        "verdict"
      ],
      "additionalProperties": false
    },
    "BrooksVerdictV1": {
      "type": "string",
      "enum": [
        "long",
        "short",
        "no_trade",
        "uncertain"
      ]
    },
    "EvidenceBalanceV1": {
      "type": "string",
      "enum": [
        "favors_long",
        "favors_short",
        "balanced",
        "insufficient",
        "conflicting"
      ]
    },
    "BroadContextV1": {
      "type": "object",
      "properties": {
        "marketState": {
          "type": "string",
          "enum": [
            "trend",
            "trading_range",
            "breakout_mode",
            "transition",
            "uncertain"
          ]
        },
        "trendDirection": {
          "type": "string",
          "enum": [
            "bull",
            "bear",
            "none",
            "uncertain"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "marketState",
        "trendDirection",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "CurrentLegV1": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "sideways",
            "uncertain"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "direction",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "AlwaysInV1": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "not_established",
            "uncertain"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "PressureAssessmentV1": {
      "type": "object",
      "properties": {
        "buying": {
          "$ref": "#/$defs/PressureSideV1"
        },
        "selling": {
          "$ref": "#/$defs/PressureSideV1"
        },
        "balance": {
          "$ref": "#/$defs/EvidenceBalanceV1"
        }
      },
      "required": [
        "buying",
        "selling",
        "balance"
      ],
      "additionalProperties": false
    },
    "PressureSideV1": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "absent",
            "present",
            "dominant",
            "uncertain"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "BreakoutLifecycleV1": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "attempt",
            "provisional",
            "confirmed",
            "failed",
            "testing",
            "uncertain"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "both",
            "none",
            "uncertain"
          ]
        },
        "structureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "direction",
        "structureId",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "ReversalLifecycleV1": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "potential",
            "transitioning",
            "confirmed",
            "failed",
            "uncertain"
          ]
        },
        "fromDirection": {
          "type": "string",
          "enum": [
            "bull",
            "bear",
            "none",
            "uncertain"
          ]
        },
        "toDirection": {
          "type": "string",
          "enum": [
            "bull",
            "bear",
            "none",
            "uncertain"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "fromDirection",
        "toDirection",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "MarketStructureV1": {
      "type": "object",
      "properties": {
        "structureId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "prior_high",
            "prior_low",
            "trading_range_high",
            "trading_range_low",
            "trading_range_midpoint",
            "breakout_point",
            "gap_boundary",
            "trend_channel_boundary",
            "measured_move_structure"
          ]
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PriceAnchorV1"
          }
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "structureId",
        "kind",
        "anchors",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "PriceAnchorV1": {
      "type": "object",
      "properties": {
        "barId": {
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/PriceFieldV1"
        },
        "normalizedReferencePrice": {
          "type": "number"
        }
      },
      "required": [
        "barId",
        "field",
        "normalizedReferencePrice"
      ],
      "additionalProperties": false
    },
    "PriceFieldV1": {
      "type": "string",
      "enum": [
        "open",
        "high",
        "low",
        "close"
      ]
    },
    "MagnetV1": {
      "type": "object",
      "properties": {
        "magnetId": {
          "type": "string"
        },
        "structureId": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "above",
            "below"
          ]
        },
        "relevance": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "magnetId",
        "structureId",
        "side",
        "relevance",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "MarketEvidenceV1": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string"
        },
        "barIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observedFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "open",
              "high",
              "low",
              "close",
              "relationship"

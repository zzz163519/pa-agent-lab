        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "both",
            "none",
            "uncertain"
          ]
        },
        "structureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "direction",
        "structureId",
        "claimIds"
      ],
      "additionalProperties": false

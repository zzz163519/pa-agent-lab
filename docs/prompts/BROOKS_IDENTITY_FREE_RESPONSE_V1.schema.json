        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "claimIds"
      ],
      "additionalProperties": false
    },
    "BreakoutLifecycleV1": {

  "required": [
    "alwaysIn",
    "breakoutLifecycle",
    "broadContext",
    "claims",
    "currentLeg",
    "evidenceBalance",
    "humanSummary",
    "longCase",
    "magnets",
    "marketEvidence",
    "noTrade",
    "pressure",
    "reversalLifecycle",
    "shortCase",
    "structures",
    "tradePlan",
    "uncertainty",
    "verdict"

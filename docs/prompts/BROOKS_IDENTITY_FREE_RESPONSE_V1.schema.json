{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pa-agent-lab.local/schemas/brooks-identity-free-response-v1",
  "title": "Brooks Identity-Free Semantic Response V1",
  "description": "Closed provider-facing projection of the 18 BrooksDecision V1 semantic fields. Local identity, cutoff, duration, schema, and record-hash fields are excluded.",
  "type": "object",
  "properties": {
    "verdict": {
      "$ref": "#/$defs/BrooksVerdictV1"
    },
    "evidenceBalance": {
      "$ref": "#/$defs/EvidenceBalanceV1"
    },
    "broadContext": {
      "$ref": "#/$defs/BroadContextV1"
    },
    "currentLeg": {
      "$ref": "#/$defs/CurrentLegV1"
    },
    "alwaysIn": {
      "$ref": "#/$defs/AlwaysInV1"
    },
    "pressure": {
      "$ref": "#/$defs/PressureAssessmentV1"
    },
    "breakoutLifecycle": {
      "$ref": "#/$defs/BreakoutLifecycleV1"
    },
    "reversalLifecycle": {
      "$ref": "#/$defs/ReversalLifecycleV1"
    },
    "structures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarketStructureV1"
      },
      "maxItems": 5
    },
    "magnets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MagnetV1"
      },
      "maxItems": 3
    },
    "marketEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarketEvidenceV1"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionClaimV1"
      }
    },
    "longCase": {
      "$ref": "#/$defs/DirectionalCaseV1"
    },
    "shortCase": {
      "$ref": "#/$defs/DirectionalCaseV1"
    },
    "tradePlan": {
      "anyOf": [
        {
          "$ref": "#/$defs/TradePlanV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "noTrade": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoTradeDecisionV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "uncertainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/UncertainDecisionV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "humanSummary": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 600
        },
        {
          "type": "null"
        }
      ]
    }
